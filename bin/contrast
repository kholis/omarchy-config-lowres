#!/usr/bin/env bash
# contrast — Wayland replacement for `xcalib -co <n>` / `xrandr --gamma`
#
# usage:
#   contrast <0.5-1.0>        set contrast compression (1.0 = untouched)
#   contrast <0.5-1.0> R G B  also set tint multipliers (default 1.0 0.98 0.95)
#   contrast off              remove contrast and tint (pure passthrough)
#   contrast                  show current values
#
# examples:
#   contrast 0.7              ≈ xcalib -co 70
#   contrast 0.85 1.0 0.95 0.9  subtle + extra warm (blue pulled down)
#
# Writes ~/.config/hypr/shaders/low-contrast.frag and reloads Hyprland,
# so the setting persists across reloads and reboots.

set -euo pipefail

SHADER="$HOME/.config/hypr/shaders/low-contrast.frag"

current() {
    if [[ ! -f "$SHADER" ]]; then
        echo "no shader file yet"
        return
    fi
    local c t
    c=$(sed -n 's/.*pix\.rgb - 0\.5) \* \([0-9.]*\) + 0\.5.*/\1/p' "$SHADER")
    t=$(sed -n 's/.*c \*= vec3(\([0-9.]*, [0-9.]*, [0-9.]*\)).*/\1/p' "$SHADER")
    [[ -n "$c" ]] && echo "contrast ${c:-1.0}, tint ${t:-1.0, 1.0, 1.0}" || echo "shader file is not contrast-generated"
}

if [[ $# -eq 0 ]]; then
    current
    exit 0
fi

val="$1"
if [[ "$val" == "off" ]]; then
    val=1.0
    set -- "$val" 1.0 1.0 1.0
elif [[ $# -eq 1 ]]; then
    set -- "$val" 1.0 0.98 0.95 # default: slight warm tint
fi

r="${2:?}" g="${3:?}" b="${4:?}"

for n in "$val" "$r" "$g" "$b"; do
    if ! [[ "$n" =~ ^[01]\.?[0-9]*$ ]]; then
        echo "contrast: '$n' is not a number in 0.0-1.0" >&2
        exit 1
    fi
done

mkdir -p "$(dirname "$SHADER")"
cat > "$SHADER" <<EOF
#version 300 es
precision highp float;

// Generated by \`contrast\`. Edit or rerun; \`hyprctl reload\` applies it.
in vec2 v_texcoord;
uniform sampler2D tex;
layout(location = 0) out vec4 fragColor;

void main() {
    vec4 pix = texture(tex, v_texcoord);
    vec3 c = (pix.rgb - 0.5) * ${val} + 0.5; // white -> grey, black -> grey
    c *= vec3(${r}, ${g}, ${b});
    fragColor = vec4(clamp(c, 0.0, 1.0), pix.a);
}
EOF

hyprctl reload >/dev/null
echo "contrast ${val}, tint ${r} ${g} ${b}"
