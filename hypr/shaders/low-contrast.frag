#version 300 es
precision highp float;

// Generated by `contrast`. Edit or rerun; `hyprctl reload` applies it.
in vec2 v_texcoord;
uniform sampler2D tex;
layout(location = 0) out vec4 fragColor;

void main() {
    vec4 pix = texture(tex, v_texcoord);
    vec3 c = (pix.rgb - 0.5) * 0.9 + 0.5; // white -> grey, black -> grey
    c *= vec3(1.0, 0.98, 0.95);
    fragColor = vec4(clamp(c, 0.0, 1.0), pix.a);
}
