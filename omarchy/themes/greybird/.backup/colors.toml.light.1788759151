mode = "light"

# Palette extracted from the installed Greybird GTK theme:
#   theme_bg_color #cecece, theme_fg_color #3c3c3c, theme_base_color #fcfcfc,
#   theme_selected_bg_color #398ee7, borders #828282, insensitive_fg #858585,
#   error #cc0000, warning #f57900, success #4e9a06 (Greybird uses Tango colors).
accent = "#398ee7"
selection = "#c3d8f2"
muted = "#858585"

background = "#cecece"
dark_background = "#b5b5b5"
darker_background = "#a3a3a3"
lighter_background = "#d9d9d9"

foreground = "#3c3c3c"
dark_foreground = "#858585"
light_foreground = "#2e2e2e"
bright_foreground = "#3c3c3c"

red = "#cc0000"
yellow = "#f57900"
orange = "#ce5c00"
green = "#4e9a06"
cyan = "#06989a"
blue = "#398ee7"
magenta = "#75507b"
brown = "#8f5902"

bright_red = "#ef2929"
bright_yellow = "#fce94f"
bright_green = "#8ae234"
bright_cyan = "#34e2e2"
bright_blue = "#729fcf"
bright_magenta = "#ad7fa8"
